# -----------------------------------------------------------------------
# Copy this file to .env before running docker-compose up.
# Only Vault credentials and ports belong here.
# All application secrets (JWT_SECRET, DB password, etc.) live in Vault.
# -----------------------------------------------------------------------

# HashiCorp Vault (dev mode)
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=root

# Service ports exposed on the host
API_PORT=8000
REDIS_PORT=6379
POSTGRES_PORT=5432
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
SFTP_PORT=2222
VAULT_PORT=8200

# Redis URL (used by the API and worker; points at the compose service name)
REDIS_URL=redis://redis:6379/0

# CORS allowed origins for the API (comma-separated)
CORS_ORIGINS=http://localhost:3000

# JWT token lifetime in seconds (default: 86400 = 24 h)
JWT_LIFETIME_SECONDS=86400

# Skip classifier weight check during local dev (no trained weights yet).
# Set to 0 or remove entirely in any environment that has real weights.
DEV_SKIP_MODEL_CHECK=1
