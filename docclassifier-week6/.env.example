# =============================================================================
# Document Classifier — environment variables
#
# Copy this file to .env before running docker-compose up.
# .env is ignored by git; never commit real secrets.
# =============================================================================

# Vault root token (dev mode — only secret that must be set in .env)
VAULT_TOKEN=root

# API host port (default 8000)
API_PORT=8000

# CORS allowed origins — comma-separated (default: localhost:3000)
CORS_ORIGINS=http://localhost:3000

# JWT token lifetime in seconds (default: 86400 = 24 h)
JWT_LIFETIME_SECONDS=86400

# Skip model integrity checks on startup (0=off, 1=skip).
# Set to 1 only during local development without trained weights.
DEV_SKIP_MODEL_CHECK=0

# Optional port overrides for MinIO console, SFTP, dashboard, and pgAdmin
# MINIO_PORT=9000
# MINIO_CONSOLE_PORT=9001
# SFTP_PORT=2222
# DASHBOARD_PORT=8501
# PGADMIN_PORT=5050
# PGADMIN_EMAIL=admin@admin.com
# PGADMIN_PASSWORD=admin